{
  "name": "aether-mcp",
  "version": "0.1.3",
  "description": "Uncensored AI tools (chat, image, RE/malware analysis, JS deobfuscation, multi-step research) for Claude Desktop, Cursor, Cline, Zed, and any MCP client.",
  "type": "module",
  "bin": {
    "aether-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "uncensored",
    "reverse-engineering",
    "ida-pro",
    "claude",
    "cursor",
    "cline",
    "zed"
  ],
  "license": "MIT",
  "homepage": "https://trynoguard.com/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/dannyphantomx64/aether-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
